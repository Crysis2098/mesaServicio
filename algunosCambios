<?php

/*
    FUNCIONES/roles.php
    Mesa de Servicio

    Basado en ACTIVACIONES_SL:
    usuarios.php obtiene usuarios desde BD.
    roles.php interpreta esos arreglos y arma permisos/menú.
*/

function obtener_tipo_usuario_mesa_servicio(
    $id_empleado,
    $administradores_mesa,
    $desarrolladores_mesa,
    $supervisores_mesa,
    $ejecutivos_mesa,
    $administrativos_mesa,
    $usuarios_mesa = []
) {
    $id_empleado = (int)$id_empleado;

    if (!empty($usuarios_mesa) && !in_array($id_empleado, $usuarios_mesa, true)) {
        return 'sin_acceso';
    }

    /*
        Orden de prioridad:
        1. Administrador del módulo
        2. Supervisor
        3. Desarrollador
        4. Ejecutivo
        5. Administrativo
        6. Usuario genérico
    */
    if (in_array($id_empleado, $administradores_mesa, true)) {
        return 'administrador_mesa';
    }

    if (in_array($id_empleado, $supervisores_mesa, true)) {
        return 'supervisor';
    }

    if (in_array($id_empleado, $desarrolladores_mesa, true)) {
        return 'desarrollador';
    }

    if (in_array($id_empleado, $ejecutivos_mesa, true)) {
        return 'ejecutivo';
    }

    if (in_array($id_empleado, $administrativos_mesa, true)) {
        return 'administrativo';
    }

    if (in_array($id_empleado, $usuarios_mesa, true)) {
        return 'usuario';
    }

    return 'sin_acceso';
}

