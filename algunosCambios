/*
    FUNCIONES/usuarios.php
    Mesa de Servicio

    Basado en el patrón de ACTIVACIONES_SL.
    Aquí solo se obtienen arreglos de id_empleado desde BD.
*/

function obtener_ids_desde_consulta($conn, $sql, $params = [])
{
    $ids = [];

    $stmt = sqlsrv_query($conn, $sql, $params);

    if ($stmt === false) {
        return $ids;
    }

    while ($row = sqlsrv_fetch_array($stmt, SQLSRV_FETCH_ASSOC)) {
        if (isset($row['id_empleado'])) {
            $ids[] = (int)$row['id_empleado'];
        }
    }

    return $ids;
}

/*
    Todos los usuarios existentes.
    No usamos columna estatus porque en producción no existe.
*/
function obtener_usuarios_mesa_servicio($conn)
{
    $sql = "SELECT id_empleado
            FROM tbl_empleados";

    return obtener_ids_desde_consulta($conn, $sql);
}

/*
    Administradores especiales de Mesa de Servicio.
    Puedes ajustar esta lista conforme autorices usuarios.
*/
function obtener_administradores_mesa_servicio($conn)
{
    $sql = "SELECT id_empleado
            FROM tbl_empleados
            WHERE id_empleado IN (546, 8804, 6046, 1602, 5274, 1971)";

    return obtener_ids_desde_consulta($conn, $sql);
}

